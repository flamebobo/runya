{
  "name": "runew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "润芽 · RUNEW — 家庭成长工作台",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build:packages": "pnpm --filter './packages/**' build",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --filter @runew/client --filter @runew/server dev",
    "predev:client": "pnpm build:packages",
    "dev:client": "pnpm --filter @runew/client dev:h5",
    "predev:server": "pnpm build:packages",
    "dev:server": "pnpm --filter @runew/server dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "db:migrate": "tsx db/scripts/migrate.ts",
    "db:check": "tsx db/scripts/check-schema.ts",
    "db:seed:knowledge": "tsx db/scripts/seed-knowledge.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@libsql/client": "^0.14.0",
    "@runew/db": "workspace:*",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0"
  }
}
